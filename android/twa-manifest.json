{
  "packageId": "com.serp.farty",
  "host": "farty.fm",
  "name": "Farty",
  "launcherName": "Farty",
  "display": "standalone",
  "orientation": "portrait",
  "themeColor": "#ffffff",
  "themeColorDark": "#ffffff",
  "navigationColor": "#ffffff",
  "navigationColorDark": "#ffffff",
  "navigationDividerColor": "#ffffff",
  "navigationDividerColorDark": "#ffffff",
  "backgroundColor": "#ffffff",
  "startUrl": "/",
  "fullScopeUrl": "https://farty.fm/",
  "iconUrl": "https://farty.fm/icon.png",
  "maskableIconUrl": "https://farty.fm/icons/maskable-512.png",
  "webManifestUrl": "https://farty.fm/manifest.webmanifest",
  "appVersionName": "1.0.0",
  "appVersionCode": 1,
  "fallbackType": "customtabs",
  "enableNotifications": false,
  "enableSiteSettingsShortcut": false,
  "signingKey": {
    "path": "~/.config/pedos/android-upload.keystore",
    "alias": "upload"
  }
}
