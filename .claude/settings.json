{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "if [ -x \"$CLAUDE_PROJECT_DIR\"/node_modules/.bin/serp-verify ]; then \"$CLAUDE_PROJECT_DIR\"/node_modules/.bin/serp-verify hook; elif [ \"$GITHUB_ACTIONS\" != true ]; then echo \"The checks can't run in $CLAUDE_PROJECT_DIR: its packages aren't installed. Run pnpm install there, then make this change again.\" >&2; exit 2; fi",
            "timeout": 30,
            "onFailure": "block"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "if [ -x \"$CLAUDE_PROJECT_DIR\"/node_modules/.bin/serp-verify ]; then \"$CLAUDE_PROJECT_DIR\"/node_modules/.bin/serp-verify stop-hook; elif [ \"$GITHUB_ACTIONS\" != true ]; then echo \"The checks can't run in $CLAUDE_PROJECT_DIR: its packages aren't installed. Run pnpm install there.\" >&2; exit 1; fi",
            "timeout": 120
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Bash(pnpm *deploy:*)",
      "Bash(pnpm *db:migrate:staging*)",
      "Bash(pnpm *db:migrate:production*)",
      "Bash(wrangler deploy*)",
      "Bash(wrangler versions deploy*)",
      "Bash(wrangler versions upload*)",
      "Bash(wrangler rollback*)",
      "Bash(wrangler delete*)",
      "Bash(npx wrangler deploy*)",
      "Bash(npx wrangler versions deploy*)",
      "Bash(npx wrangler versions upload*)",
      "Bash(npx wrangler rollback*)",
      "Bash(npx wrangler delete*)",
      "Bash(pnpm wrangler deploy*)",
      "Bash(pnpm wrangler versions deploy*)",
      "Bash(pnpm wrangler versions upload*)",
      "Bash(pnpm wrangler rollback*)",
      "Bash(pnpm wrangler delete*)",
      "Bash(pnpm exec wrangler deploy*)",
      "Bash(pnpm exec wrangler versions deploy*)",
      "Bash(pnpm exec wrangler versions upload*)",
      "Bash(pnpm exec wrangler rollback*)",
      "Bash(pnpm exec wrangler delete*)",
      "Bash(opennextjs-cloudflare deploy*)",
      "Bash(opennextjs-cloudflare upload*)",
      "Bash(npx opennextjs-cloudflare deploy*)",
      "Bash(npx opennextjs-cloudflare upload*)",
      "Bash(pnpm exec opennextjs-cloudflare deploy*)",
      "Bash(pnpm exec opennextjs-cloudflare upload*)",
      "PowerShell(pnpm *deploy:*)",
      "PowerShell(pnpm *db:migrate:staging*)",
      "PowerShell(pnpm *db:migrate:production*)",
      "PowerShell(wrangler deploy*)",
      "PowerShell(wrangler versions deploy*)",
      "PowerShell(wrangler versions upload*)",
      "PowerShell(wrangler rollback*)",
      "PowerShell(wrangler delete*)",
      "PowerShell(npx wrangler deploy*)",
      "PowerShell(npx wrangler versions deploy*)",
      "PowerShell(npx wrangler versions upload*)",
      "PowerShell(npx wrangler rollback*)",
      "PowerShell(npx wrangler delete*)",
      "PowerShell(pnpm wrangler deploy*)",
      "PowerShell(pnpm wrangler versions deploy*)",
      "PowerShell(pnpm wrangler versions upload*)",
      "PowerShell(pnpm wrangler rollback*)",
      "PowerShell(pnpm wrangler delete*)",
      "PowerShell(pnpm exec wrangler deploy*)",
      "PowerShell(pnpm exec wrangler versions deploy*)",
      "PowerShell(pnpm exec wrangler versions upload*)",
      "PowerShell(pnpm exec wrangler rollback*)",
      "PowerShell(pnpm exec wrangler delete*)",
      "PowerShell(opennextjs-cloudflare deploy*)",
      "PowerShell(opennextjs-cloudflare upload*)",
      "PowerShell(npx opennextjs-cloudflare deploy*)",
      "PowerShell(npx opennextjs-cloudflare upload*)",
      "PowerShell(pnpm exec opennextjs-cloudflare deploy*)",
      "PowerShell(pnpm exec opennextjs-cloudflare upload*)",
      "Bash(wrangler d1 time-travel restore*)",
      "Bash(npx wrangler d1 time-travel restore*)",
      "Bash(pnpm wrangler d1 time-travel restore*)",
      "Bash(pnpm exec wrangler d1 time-travel restore*)",
      "PowerShell(wrangler d1 time-travel restore*)",
      "PowerShell(npx wrangler d1 time-travel restore*)",
      "PowerShell(pnpm wrangler d1 time-travel restore*)",
      "PowerShell(pnpm exec wrangler d1 time-travel restore*)"
    ],
    "ask": [
