      "PowerShell(gh api *DELETE*)",
      "PowerShell(gh api *secrets*)",
      "PowerShell(gh api *actions/variables*)",
      "PowerShell(gh api *environments*)",
      "PowerShell(gh api *rulesets*)",
      "PowerShell(gh api *protection*)",
      "PowerShell(gh api *collaborators*)",
      "PowerShell(gh api *pulls/*/merge*)"
    ]
  }
}
