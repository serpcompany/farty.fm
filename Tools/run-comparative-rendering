#!/bin/zsh
set -euo pipefail

repository_root="$(git rev-parse --show-toplevel)"
comparison_scratch="$(mktemp -d "${TMPDIR:-/tmp}/pedos-comparative-rendering.XXXXXX")"
trap 'rm -rf "$comparison_scratch"' EXIT

git -C "$repository_root" archive prototype/internal-fixture-library FixtureLibrary |
  tar -x -C "$comparison_scratch"

swiftc \
  "$repository_root/RecorderProof/RecordingAnalysis.swift" \
  "$repository_root/Tools/ComparativeRenderingCLI.swift" \
  -o "$comparison_scratch/comparative-rendering"

cd "$repository_root"
"$comparison_scratch/comparative-rendering" \
  "$comparison_scratch/FixtureLibrary/approved-recordings.json" \
  "$comparison_scratch/FixtureLibrary" \
  "$repository_root/Evidence/comparative-rendering"
