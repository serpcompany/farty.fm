{
  "$schema": "https://biomejs.dev/schemas/2.4.2/schema.json",
  "extends": ["@serpcompany/verify/biome"],
  "files": {
    "includes": [
      "**",
      "!node_modules",
      "!.next",
      "!.open-next",
      "!.wrangler",
      "!test-results",
      "!playwright-report",
      "!cloudflare-env.d.ts",
      "!drizzle",
      "!public/catalog",
      "!src/lib/catalog/*.generated.ts",
      "!src/test-support/*.generated.ts"
    ]
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "linter": {
    "domains": {
      "next": "recommended",
      "react": "recommended"
    }
  },
  "overrides": [
    {
      "includes": ["src/components/ui/**"],
      "linter": {
        "rules": {
          "a11y": {
            "useSemanticElements": "off",
            "useKeyWithClickEvents": "off",
            "useFocusableInteractive": "off"
          }
        }
      }
    },
    {
      "includes": ["src/lib/**", "!**/*.test.ts", "!**/*.test.tsx"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@/components",
                      "@/components/**",
                      "@/app",
                      "@/app/**",
                      "@/hooks",
                      "@/hooks/**"
                    ],
                    "message": "src/lib holds the app's logic, which components, hooks and routes build on, so it never imports them. Move what both sides need into src/lib."
                  },
                  {
                    "group": ["@/server", "@/server/**", "@/db", "@/db/**"],
                    "message": "src/lib runs in the browser too, and server code never reaches it. Move what both need into src/lib, and keep the server's part in src/server."
                  },
                  {
                    "group": [
                      "@/test-support/songs.generated",
                      "**/songs.generated",
                      "@/lib/catalog/song-index.generated",
                      "**/song-index.generated"
                    ],
                    "message": "The browser fetches the Song Catalog (loadSongs and loadSong), so its Songs stay out of the JavaScript (#322). Only routes and the server import song-index.generated, and only tests songs.generated."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/components/**", "src/hooks/**", "!**/*.test.ts", "!**/*.test.tsx"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@/app", "@/app/**"],
                    "message": "Routes (src/app) import components and hooks, never the reverse. Pass what a component needs as a prop, or move shared code into src/lib."
                  },
                  {
                    "group": [
                      "@/test-support/songs.generated",
                      "**/songs.generated",
                      "@/lib/catalog/song-index.generated",
                      "**/song-index.generated"
                    ],
                    "message": "The browser fetches the Song Catalog (loadSongs and loadSong), so its Songs stay out of the JavaScript (#322). Only routes and the server import song-index.generated, and only tests songs.generated."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/app/**", "!**/*.test.ts", "!**/*.test.tsx"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@/test-support/songs.generated", "**/songs.generated"],
                    "message": "songs.generated carries every Song's notes, so the Worker would too (#323). Routes and the server read song-index.generated; only tests import songs.generated."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/server/**", "src/db/**", "!**/*.test.ts", "!**/*.test.tsx"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@/components",
                      "@/components/**",
                      "@/app",
                      "@/app/**",
                      "@/hooks",
                      "@/hooks/**"
                    ],
                    "message": "Server code serves routes and never imports screens or routes. Move what both need into src/lib."
                  },
                  {
                    "group": ["@/test-support/songs.generated", "**/songs.generated"],
                    "message": "songs.generated carries every Song's notes, so the Worker would too (#323). Routes and the server read song-index.generated; only tests import songs.generated."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/lib/analysis/**", "src/lib/engine/**", "!**/*.test.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedGlobals": {
              "level": "error",
              "options": {
                "deniedGlobals": {
                  "window": "Recording Analysis and the engine run in a Web Worker and in Vitest, where there's no window. Take what you need as an argument.",
                  "document": "Recording Analysis and the engine run in a Web Worker and in Vitest, where there's no document.",
                  "navigator": "Recording Analysis and the engine run in a Web Worker and in Vitest. Take what you need as an argument.",
                  "localStorage": "Recording Analysis and the engine run in a Web Worker, which has no localStorage.",
                  "AudioContext": "Recording Analysis and the engine work on samples, not Web Audio, so they run in a Web Worker and in Vitest.",
                  "OfflineAudioContext": "Recording Analysis and the engine work on samples, not Web Audio, so they run in a Web Worker and in Vitest."
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/server/link-preview.tsx"],
      "linter": {
        "rules": {
          "performance": {
            "noImgElement": "off"
          }
        }
      }
    },
    {
      "includes": ["e2e/**/*.spec.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "@playwright/test": {
                    "importNames": ["test", "expect"],
                    "message": "Import test and expect from ./test, which fails a journey on any console error or page error the journey does not expect (docs/agents/web-gotchas.md, The journeys)."
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
