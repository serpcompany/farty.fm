{
  "$schema": "https://biomejs.dev/schemas/2.4.2/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!node_modules",
      "!.next",
      "!.open-next",
      "!.wrangler",
      "!e2e/results",
      "!e2e/report",
      "!cloudflare-env.d.ts",
      "!drizzle",
      "!public/catalog",
      "!src/lib/catalog/*.generated.ts"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf",
    "lineWidth": 100
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    },
    "domains": {
      "next": "recommended",
      "react": "recommended"
    }
  },
  "overrides": [
    {
      "includes": ["src/components/ui/**"],
      "linter": {
        "rules": {
          "a11y": {
            "useSemanticElements": "off",
            "useKeyWithClickEvents": "off",
            "useFocusableInteractive": "off"
          }
        }
      }
    },
    {
      "includes": ["src/lib/**", "!**/*.test.ts", "!**/*.test.tsx"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@/components",
                      "@/components/**",
                      "@/app",
                      "@/app/**",
                      "@/hooks",
                      "@/hooks/**"
                    ],
                    "message": "src/lib holds the app's logic, which components, hooks and routes build on, so it never imports them. Move what both sides need into src/lib."
                  },
                  {
                    "group": [
                      "@/lib/catalog/songs.generated",
                      "**/songs.generated",
                      "@/lib/catalog/song-index.generated",
                      "**/song-index.generated"
                    ],
                    "message": "The browser fetches the Song Catalog (loadSongs and loadSong, or usePedos()), so its Songs stay out of the JavaScript (#322). Only routes and the server import song-index.generated, and only tests songs.generated."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/components/**", "src/hooks/**", "!**/*.test.ts", "!**/*.test.tsx"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@/app", "@/app/**"],
                    "message": "Routes (src/app) import components and hooks, never the reverse. Pass what a component needs as a prop, or move shared code into src/lib."
                  },
                  {
                    "group": [
                      "@/lib/catalog/songs.generated",
                      "**/songs.generated",
                      "@/lib/catalog/song-index.generated",
                      "**/song-index.generated"
                    ],
                    "message": "The browser fetches the Song Catalog (loadSongs and loadSong, or usePedos()), so its Songs stay out of the JavaScript (#322). Only routes and the server import song-index.generated, and only tests songs.generated."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ],
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded",
      "trailingCommas": "none",
      "arrowParentheses": "asNeeded"
    }
  }
}
