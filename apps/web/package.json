{
  "name": "pedos-web",
  "version": "1.1.1",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "format": "biome format --write",
    "lint": "biome check",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "build:staging": "tsx scripts/fixture-library.ts copy && SITE_ENV=staging NEXT_PUBLIC_FIXTURE_LIBRARY=1 opennextjs-cloudflare build",
    "build:production": "tsx scripts/fixture-library.ts remove && SITE_ENV=production NEXT_PUBLIC_FIXTURE_LIBRARY= opennextjs-cloudflare build && tsx scripts/fixture-library.ts check",
    "deploy:staging": "pnpm build:staging && opennextjs-cloudflare deploy --env staging",
    "deploy:production": "pnpm build:production && opennextjs-cloudflare deploy --env production",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv ./cloudflare-env.d.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@opennextjs/cloudflare": "^1.20.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.4.0",
    "idb": "^8.0.3",
    "lucide-react": "^1.52.0",
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.21.2",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.2",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "happy-dom": "^20.14.5",
    "mpg123-decoder": "^1.0.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3",
    "wrangler": "^4.147.0"
  },
  "packageManager": "pnpm@10.17.0",
  "engines": {
    "node": ">=22.13.0"
  }
}
