{
  "name": "pedos-web",
  "version": "1.5.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "format": "biome format --write",
    "lint": "biome check",
    "typecheck": "pnpm cf-typegen:check && next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "pnpm lint && pnpm typecheck && pnpm db:check && pnpm test && pnpm build",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:migrations:list:local": "wrangler d1 migrations list pedos-local --local",
    "db:migrate:local": "wrangler d1 migrations apply pedos-local --local",
    "db:migrations:list:staging": "wrangler d1 migrations list pedos-staging --remote --env staging",
    "db:migrate:staging": "wrangler d1 migrations apply pedos-staging --remote --env staging",
    "db:migrations:list:production": "wrangler d1 migrations list pedos-production --remote --env production",
    "db:migrate:production": "wrangler d1 migrations apply pedos-production --remote --env production",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "build:staging": "tsx scripts/fixture-library.ts copy && SITE_ENV=staging NEXT_PUBLIC_FIXTURE_LIBRARY=1 opennextjs-cloudflare build",
    "build:production": "tsx scripts/fixture-library.ts remove && SITE_ENV=production NEXT_PUBLIC_FIXTURE_LIBRARY= opennextjs-cloudflare build && tsx scripts/fixture-library.ts check",
    "deploy:staging": "pnpm build:staging && opennextjs-cloudflare deploy --env staging",
    "deploy:production": "pnpm build:production && opennextjs-cloudflare deploy --env production",
    "cf-typegen": "wrangler types --env-file scripts/cf-typegen.env --env-interface CloudflareEnv ./cloudflare-env.d.ts",
    "cf-typegen:check": "wrangler types --env-file scripts/cf-typegen.env --env-interface CloudflareEnv ./cloudflare-env.d.ts --check"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@opennextjs/cloudflare": "^1.20.8",
    "better-auth": "1.7.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.4.0",
    "drizzle-orm": "0.45.4",
    "idb": "^8.0.3",
    "lucide-react": "^1.52.0",
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "shadcn": "^4.21.2",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "uqr": "0.1.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.2",
    "@cloudflare/vitest-plugin": "^1.4.6",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "0.31.11",
    "fake-indexeddb": "^6.2.6",
    "happy-dom": "^20.14.5",
    "mpg123-decoder": "^1.0.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3",
    "wrangler": "^4.147.0",
    "yaml": "2.9.1"
  },
  "packageManager": "pnpm@10.17.0",
  "engines": {
    "node": ">=22.13.0"
  }
}
