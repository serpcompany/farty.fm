{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pedos-web",
  "account_id": "cec5f04e1d18bcc65f2be0aefb04f059",
  "main": "worker.ts",
  "compatibility_date": "2026-09-28",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets"
  },
  "observability": { "enabled": true },
  "upload_source_maps": true,
  "workers_dev": false,
  "preview_urls": false,
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "pedos-web" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pedos-local",
      "database_id": "local-only-do-not-deploy",
      "migrations_dir": "drizzle",
      "migrations_table": "d1_migrations",
      "remote": false
    }
  ],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "pedos-local", "remote": false }],
  "kv_namespaces": [{ "binding": "DEV_MAILBOX" }],
  "ratelimits": [
    {
      "name": "TELEMETRY_RATE_LIMIT",
      "namespace_id": "126001",
      "simple": { "limit": 30, "period": 60 }
    }
  ],
  "env": {
    "staging": {
      "vars": {
        "SITE_ENV": "staging",
        "STAGING_BASIC_AUTH_PASSWORD": "stagingpassword",
        "BETTER_AUTH_URL": "https://staging.farty.fm",
        "EMAIL_FROM": "Farty <support@farty.fm>",
        "STAGING_SIGNUP_ALLOWLIST": "devin@serp.co"
      },
      "send_email": [
        {
          "name": "EMAIL",
          "allowed_sender_addresses": ["support@farty.fm"],
          "allowed_destination_addresses": ["devin@serp.co"]
        }
      ],
      "assets": {
        "binding": "ASSETS",
        "directory": ".open-next/assets",
        "run_worker_first": true
      },
      "workers_dev": true,
      "preview_urls": false,
      "routes": [{ "pattern": "staging.farty.fm", "custom_domain": true }],
      "observability": { "enabled": true },
      "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "pedos-web-staging" }],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "pedos-staging",
          "database_id": "df88f16e-3999-4d6d-b210-b7c016e97b18",
          "migrations_dir": "drizzle",
          "migrations_table": "d1_migrations"
        }
      ],
      "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "pedos-staging" }],
      "ratelimits": [
        {
          "name": "TELEMETRY_RATE_LIMIT",
          "namespace_id": "126002",
          "simple": { "limit": 30, "period": 60 }
        }
      ]
    },
    "production": {
      "vars": {
        "SITE_ENV": "production",
        "BETTER_AUTH_URL": "https://farty.fm",
        "EMAIL_FROM": "Farty <support@farty.fm>"
      },
      "send_email": [{ "name": "EMAIL", "allowed_sender_addresses": ["support@farty.fm"] }],
      "workers_dev": true,
      "preview_urls": false,
      "routes": [
        { "pattern": "farty.fm", "custom_domain": true },
        { "pattern": "www.farty.fm", "custom_domain": true }
      ],
      "observability": { "enabled": true },
      "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "pedos-web-production" }],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "pedos-production",
          "database_id": "f7ceaad1-93ba-495d-981b-86a0c2f1eea7",
          "migrations_dir": "drizzle",
          "migrations_table": "d1_migrations"
        }
      ],
      "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "pedos-production" }],
      "ratelimits": [
        {
          "name": "TELEMETRY_RATE_LIMIT",
          "namespace_id": "126003",
          "simple": { "limit": 30, "period": 60 }
        }
      ]
    }
  }
}
